{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "even-g2-orca",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-28",
  "workers_dev": true,
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
  },
  "observability": { "enabled": false },
  "vars": { "ORCA_BRIDGE_ORIGIN": "", "ALLOWED_ORIGINS": "" },
}
