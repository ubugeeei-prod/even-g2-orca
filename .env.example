# Loaded by `nix run .#bridge` from the current directory.
# Listener. Keep loopback with Cloudflare Tunnel; use 0.0.0.0 only for LAN use.
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=3210
# Optional. Otherwise a random token is created and kept in the user's state dir.
BRIDGE_TOKEN=
# URL printed in the pairing link: the Worker URL, or http://<mac-ip>:3210 on a LAN.
BRIDGE_PUBLIC_URL=
# Extra browser origins allowed to call the API directly (comma separated).
BRIDGE_ALLOWED_ORIGINS=
# Overrides; the macOS app is detected automatically.
ORCA_CLI_PATH=
ORCA_USER_DATA_PATH=
# Optional local speech recognition with whisper.cpp. Audio never leaves the Mac.
WHISPER_CLI_PATH=
WHISPER_MODEL_PATH=
WHISPER_LANGUAGE=ja
