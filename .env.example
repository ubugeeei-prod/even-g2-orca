# Bridge listener. Use Cloudflare Tunnel and a loopback listener in production.
BRIDGE_HOST=0.0.0.0
BRIDGE_PORT=3210
# Optional; otherwise generated and persisted in .local/bridge-token.
BRIDGE_TOKEN=
# Optional public HTTPS or LAN origin, also used for the pairing QR.
BRIDGE_PUBLIC_URL=
# Optional origins for a separately hosted Even Hub package (comma separated).
BRIDGE_ALLOWED_ORIGINS=
# The launcher or CLI entrypoint. The bridge detects the macOS app automatically.
ORCA_CLI_PATH=
ORCA_USER_DATA_PATH=
# Optional local speech recognition. No audio leaves your Mac.
WHISPER_CLI_PATH=
WHISPER_MODEL_PATH=
WHISPER_LANGUAGE=ja
